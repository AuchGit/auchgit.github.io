---
import Base from '../layouts/Base.astro'
import { news, allProjects, launcher, projectUrl, date } from '../lib/site.js'
const projectOf = id => allProjects.find(p => p.id === id) || (id === 'launcher' ? launcher : null)
// Group by month for a calmer timeline.
const groups = []
for (const n of news) {
  const key = new Date(n.date).toLocaleDateString('de-DE', { month: 'long', year: 'numeric' })
  let g = groups.find(x => x.key === key)
  if (!g) groups.push((g = { key, items: [] }))
  g.items.push(n)
}
---
<Base title="Neuigkeiten" description="Neue Versionen aller Spiele und Tools.">
  <section class="mx-auto max-w-4xl px-5 pt-16 sm:px-8">
    <h1 class="font-display text-4xl font-bold sm:text-5xl">Neuigkeiten</h1>
    {groups.map(g => (
      <div class="mt-14">
        <h2 class="label">{g.key}</h2>
        <div class="mt-5 space-y-4">
          {g.items.map(n => {
            const p = projectOf(n.project)
            return (
              <article class="card flex gap-5 p-6">
                <div class="w-1 shrink-0 rounded-full" style={`background:${n.accent}`}></div>
                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                    <a href={p ? projectUrl(p) : '#'} class="font-display text-lg font-semibold hover:underline">{n.name}</a>
                    <span class="font-semibold" style={`color:${n.accent}`}>Version {n.version}</span>
                    <time class="ml-auto text-sm text-ink-500" datetime={n.date}>{date(n.date)}</time>
                  </div>
                  {n.notes.length ? (
                    <ul class="mt-3 space-y-1.5 text-[0.95rem] leading-relaxed text-ink-300">
                      {n.notes.slice(0, 6).map(t => <li class="flex gap-2.5"><span class="mt-[0.6em] h-1 w-1 shrink-0 rounded-full bg-ink-500"></span><span>{t}</span></li>)}
                    </ul>
                  ) : <p class="mt-2 text-sm text-ink-500">Neue Version.</p>}
                </div>
              </article>
            )
          })}
        </div>
      </div>
    ))}
  </section>
</Base>
