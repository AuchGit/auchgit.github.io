---
import Base from '../layouts/Base.astro'
import ProjectCard from '../components/ProjectCard.astro'
import DownloadButton from '../components/DownloadButton.astro'
import Art from '../components/Art.astro'
import { site, games, tools, launcher, news, shortDate, alpha, projectUrl, allProjects } from '../lib/site.js'

const recent = news.slice(0, 6)
const projectOf = id => allProjects.find(p => p.id === id) || (id === 'launcher' ? launcher : null)
---
<Base>
  <!-- Hero -->
  <section class="mx-auto grid max-w-7xl items-center gap-12 px-5 pb-6 pt-12 sm:px-8 lg:grid-cols-[1fr_1.25fr] lg:pt-20">
    <h1 class="sr-only">{site.brand}</h1>
    <div class="reveal">
      <div class="flex items-center gap-3">
        <img src="/logo.svg" alt="" class="h-11 w-11" />
        <span class="font-display text-2xl font-bold">AuchLauncher</span>
      </div>
      <p class="mt-6 text-lg leading-relaxed text-ink-200">
        Moin! Der Launcher ist ein kleines Programm für Windows, über das du meine Games holst und startest.
      </p>
      <ul class="mt-5 space-y-2.5 text-ink-300">
        <li class="flex gap-3"><span class="mt-[0.6em] h-1.5 w-1.5 shrink-0 rounded-full bg-brand-400"></span>Alle Games an einem Ort, mit einem Klick installiert</li>
        <li class="flex gap-3"><span class="mt-[0.6em] h-1.5 w-1.5 shrink-0 rounded-full bg-brand-400"></span>Updates laufen von allein, du musst dich um nichts kümmern</li>
        <li class="flex gap-3"><span class="mt-[0.6em] h-1.5 w-1.5 shrink-0 rounded-full bg-brand-400"></span>Neue Games tauchen einfach auf</li>
      </ul>
      <div class="mt-8 flex flex-wrap gap-3">
        <DownloadButton release={launcher.latest} label="Launcher laden" />
        <a href="/spiele/" class="btn btn-soft">Spiele</a>
      </div>
      <p class="mt-4 text-sm text-ink-500">
        Für Windows 10 und 11, kostenlos. Mit einem <a href="/konto/" class="font-semibold text-brand-300 hover:text-white">Account</a> kannst du außerdem deine Leute adden.
      </p>
    </div>
    <a href="/launcher/" class="reveal block overflow-hidden rounded-2xl ring-1 ring-white/10 shadow-[0_50px_120px_-40px_rgba(109,93,252,0.7)] transition hover:scale-[1.01]" style="animation-delay:120ms">
      <img src="/img/launcher-library.jpg" alt="So sieht der AuchLauncher aus" class="w-full" />
    </a>
  </section>

  <!-- Games -->
  <section class="mx-auto max-w-7xl px-5 pt-16 sm:px-8">
    <h2 class="font-display text-3xl font-semibold">Spiele</h2>
    <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {games.map((g, i) => <ProjectCard project={g} index={i} />)}
    </div>
  </section>

  <!-- Tools -->
  {tools.length > 0 && (
    <section class="mx-auto max-w-7xl px-5 pt-20 sm:px-8">
      <h2 class="font-display text-3xl font-semibold">Tools</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {tools.map((t, i) => <ProjectCard project={t} index={i} />)}
      </div>
    </section>
  )}

  <!-- News -->
  <section class="mx-auto max-w-7xl px-5 pt-20 sm:px-8">
    <div class="flex items-end justify-between gap-4">
      <h2 class="font-display text-3xl font-semibold">Neu</h2>
      <a href="/neuigkeiten/" class="text-sm font-semibold text-ink-300 hover:text-white">Alle &rarr;</a>
    </div>
    <div class="mt-6 grid gap-4 md:grid-cols-2">
      {recent.map(n => {
        const p = projectOf(n.project)
        return (
          <a href={p ? projectUrl(p) : '/neuigkeiten/'} class="card group flex gap-4 p-5 transition hover:border-white/15">
            <div class="w-1 shrink-0 rounded-full" style={`background:${n.accent}`}></div>
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-baseline gap-x-2">
                <span class="font-semibold">{n.name}</span>
                <span class="text-sm font-semibold" style={`color:${n.accent}`}>{n.version}</span>
                <span class="ml-auto text-xs text-ink-500">{shortDate(n.date)}</span>
              </div>
              <p class="mt-1.5 line-clamp-2 text-sm leading-relaxed text-ink-300">{n.notes.join(' · ') || 'Neue Version.'}</p>
            </div>
          </a>
        )
      })}
    </div>
  </section>
</Base>
