---
import Base from '../layouts/Base.astro'
import ProjectCard from '../components/ProjectCard.astro'
import DownloadButton from '../components/DownloadButton.astro'
import Art from '../components/Art.astro'
import { site, games, tools, launcher, news, shortDate, alpha, projectUrl, allProjects } from '../lib/site.js'

const stack = games.filter(g => g.art).slice(0, 3)
const recent = news.slice(0, 6)
const projectOf = id => allProjects.find(p => p.id === id) || (id === 'launcher' ? launcher : null)
---
<Base>
  <!-- Hero -->
  <section class="mx-auto max-w-7xl px-5 pb-6 pt-12 sm:px-8 lg:pt-16">
    <h1 class="sr-only">{site.brand}</h1>
    <!-- fanned covers -->
    <div class="reveal relative mx-auto h-[19rem] w-full max-w-3xl sm:h-[27rem]">
      {stack.map((g, i) => {
        const pos = [
          'left-0 top-10 -rotate-6',
          'right-0 top-0 rotate-[5deg]',
          'left-1/2 top-24 -translate-x-1/2 rotate-[-1deg] z-10',
        ][i]
        return (
          <a href={`/spiele/${g.id}/`} class:list={['group absolute w-[70%] transition duration-500 hover:z-20 hover:scale-[1.03] hover:rotate-0', pos]}>
            <Art project={g} class="aspect-[16/10] rounded-2xl ring-1 ring-white/15" eager />
            <div class="absolute inset-0 rounded-2xl" style={`box-shadow: 0 40px 90px -30px ${alpha(g.accent, 0.75)}`}></div>
            <span class="chip absolute bottom-3 left-3 bg-black/55 text-white backdrop-blur">{g.name}</span>
          </a>
        )
      })}
    </div>
    <div class="reveal mt-10 flex flex-wrap justify-center gap-3" style="animation-delay:120ms">
      <DownloadButton release={launcher.latest} label="Launcher laden" />
      <a href="/spiele/" class="btn btn-soft">Spiele</a>
    </div>
  </section>

  <!-- Games -->
  <section class="mx-auto max-w-7xl px-5 pt-16 sm:px-8">
    <h2 class="font-display text-3xl font-semibold">Spiele</h2>
    <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {games.map((g, i) => <ProjectCard project={g} index={i} />)}
    </div>
  </section>

  <!-- Launcher -->
  <section class="mx-auto max-w-7xl px-5 pt-20 sm:px-8">
    <div class="card relative overflow-hidden p-6 sm:p-8">
      <div class="pointer-events-none absolute -right-40 -top-40 h-[26rem] w-[26rem] rounded-full opacity-30 blur-[100px]" style="background: radial-gradient(closest-side,#6d5dfc,transparent)"></div>
      <div class="relative grid items-center gap-8 md:grid-cols-[1.3fr_1fr]">
        <a href="/launcher/" class="block overflow-hidden rounded-xl ring-1 ring-white/10 transition hover:scale-[1.01]">
          <img src="/img/launcher-library.jpg" alt="Der AuchLauncher" loading="lazy" class="w-full" />
        </a>
        <div>
          <div class="flex items-center gap-3">
            <img src="/logo.svg" alt="" class="h-10 w-10" />
            <h2 class="font-display text-3xl font-semibold">AuchLauncher</h2>
          </div>
          <p class="mt-3 text-ink-300">Alle Spiele in einem Programm, Updates kommen von selbst.</p>
          <div class="mt-6 flex flex-wrap gap-3">
            <DownloadButton release={launcher.latest} label="Laden" />
            <a href="/launcher/" class="btn btn-soft">Mehr</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Tools -->
  {tools.length > 0 && (
    <section class="mx-auto max-w-7xl px-5 pt-20 sm:px-8">
      <h2 class="font-display text-3xl font-semibold">Tools</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {tools.map((t, i) => <ProjectCard project={t} index={i} />)}
      </div>
    </section>
  )}

  <!-- News -->
  <section class="mx-auto max-w-7xl px-5 pt-20 sm:px-8">
    <div class="flex items-end justify-between gap-4">
      <h2 class="font-display text-3xl font-semibold">Neu</h2>
      <a href="/neuigkeiten/" class="text-sm font-semibold text-ink-300 hover:text-white">Alle &rarr;</a>
    </div>
    <div class="mt-6 grid gap-4 md:grid-cols-2">
      {recent.map(n => {
        const p = projectOf(n.project)
        return (
          <a href={p ? projectUrl(p) : '/neuigkeiten/'} class="card group flex gap-4 p-5 transition hover:border-white/15">
            <div class="w-1 shrink-0 rounded-full" style={`background:${n.accent}`}></div>
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-baseline gap-x-2">
                <span class="font-semibold">{n.name}</span>
                <span class="text-sm font-semibold" style={`color:${n.accent}`}>{n.version}</span>
                <span class="ml-auto text-xs text-ink-500">{shortDate(n.date)}</span>
              </div>
              <p class="mt-1.5 line-clamp-2 text-sm leading-relaxed text-ink-300">{n.notes.join(' · ') || 'Neue Version.'}</p>
            </div>
          </a>
        )
      })}
    </div>
  </section>
</Base>
