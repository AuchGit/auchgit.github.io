---
import Base from '../layouts/Base.astro'
---
<Base title="Nicht gefunden">
  <section class="mx-auto grid min-h-[60vh] max-w-xl place-items-center px-5 text-center">
    <div>
      <div class="font-display text-8xl font-bold text-gradient">404</div>
      <h1 class="mt-4 font-display text-2xl font-semibold">Diese Seite gibt es nicht</h1>
      <p class="mt-2 text-ink-400">Vielleicht wurde sie verschoben. Auf der Startseite findest du alles.</p>
      <a href="/" class="btn btn-brand mt-8">Zur Startseite</a>
    </div>
  </section>
</Base>
