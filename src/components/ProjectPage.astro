---
import Art from './Art.astro'
import DownloadButton from './DownloadButton.astro'
import ReleaseList from './ReleaseList.astro'
import { launcher, alpha, bytes, date } from '../lib/site.js'

const { project, back } = Astro.props
const l = project.latest
const isGame = project.kind === 'game'
---
<section class="relative">
  <!-- blurred artwork behind the header -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[40rem] overflow-hidden">
    <Art project={project} class="absolute -inset-20 opacity-30 blur-[80px] saturate-150" />
    <div class="absolute inset-0 bg-gradient-to-b from-ink-900/20 via-ink-900/70 to-ink-900"></div>
  </div>

  <div class="mx-auto max-w-7xl px-5 pt-10 sm:px-8">
    <a href={back.href} class="inline-flex items-center gap-2 text-sm font-semibold text-ink-300 hover:text-white">&larr; {back.label}</a>

    <div class="mt-8 grid items-center gap-10 lg:grid-cols-[1.25fr_1fr]">
      <div class="reveal overflow-hidden rounded-3xl ring-1 ring-white/10" style={`box-shadow: 0 50px 120px -40px ${alpha(project.accent, 0.7)}`}>
        <Art project={project} class="aspect-[16/9] w-full" big eager />
      </div>
      <div class="reveal" style="animation-delay:100ms">
        <div class="flex flex-wrap gap-2">{project.genres.map(g => <span class="chip">{g}</span>)}</div>
        <h1 class="mt-5 font-display text-5xl font-bold tracking-tight sm:text-6xl">{project.name}</h1>
        {project.tagline && <p class="mt-3 text-xl text-ink-200">{project.tagline}</p>}
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          {isGame ? (
            <>
              <DownloadButton release={launcher.latest} label="Mit dem Launcher holen" />
            </>
          ) : (
            <>
              {project.web && (
                <a href={project.web} class="btn btn-brand" target="_blank" rel="noopener">
                  Im Browser öffnen
                  <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M9 7h8v8"/></svg>
                </a>
              )}
              <DownloadButton release={l} label="Für Windows" variant={project.web ? 'soft' : 'brand'} />
            </>
          )}
        </div>
        {isGame && <p class="mt-4 max-w-md text-sm text-ink-400">Games gibt es nur über den Launcher. Einmal installieren, dann hast du alle und bist immer auf dem neuesten Stand.</p>}
      </div>
    </div>
  </div>
</section>

<section class="mx-auto mt-20 grid max-w-7xl gap-12 px-5 sm:px-8 lg:grid-cols-[1fr_340px]">
  <div class="min-w-0">
    {project.description && (
      <>
        <div class="label">{isGame ? 'Über das Spiel' : 'Über das Tool'}</div>
        <p class="mt-4 max-w-3xl text-lg leading-relaxed text-ink-200">{project.description}</p>
      </>
    )}
    <div class="label mt-16">Versionen</div>
    <div class="mt-6"><ReleaseList releases={project.releases} accent={project.accent} /></div>
  </div>

  <aside class="card h-fit p-6 lg:sticky lg:top-24">
    <dl class="divide-y divide-white/[0.06] text-sm">
      <div class="flex justify-between gap-4 pb-3"><dt class="text-ink-400">Version</dt><dd class="font-semibold">{l?.version || '-'}</dd></div>
      <div class="flex justify-between gap-4 py-3"><dt class="text-ink-400">Veröffentlicht</dt><dd>{l ? date(l.date) : '-'}</dd></div>
      <div class="flex justify-between gap-4 py-3"><dt class="text-ink-400">Größe</dt><dd>{l?.download ? bytes(l.download.size) : '-'}</dd></div>
      <div class="flex justify-between gap-4 py-3"><dt class="text-ink-400">System</dt><dd>Windows 10 / 11{project.web ? ' · Browser' : ''}</dd></div>
      <div class="flex justify-between gap-4 pt-3"><dt class="text-ink-400">Updates</dt><dd>automatisch</dd></div>
    </dl>
  </aside>
</section>
