---
import '../styles/global.css'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import { site } from '../lib/site.js'

const { title, description = site.intro, image = '/art/dissonance.jpg', accent = '#8f82ff', installable = true } = Astro.props
const fullTitle = title ? `${title} · ${site.brand}` : site.brand
const canonical = new URL(Astro.url.pathname, Astro.site)
const ogImage = new URL(image, Astro.site)
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0b0c11" />
    {installable && <link rel="manifest" href="/manifest.webmanifest" />}
    {installable && <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />}
    {installable && <script is:inline>
      // keep the browser's "install" offer for our own button (chat page)
      window.addEventListener('beforeinstallprompt', function (e) { e.preventDefault(); window.__auchInstall = e; window.dispatchEvent(new Event('auch-install')) })
    </script>}
    <!-- for friends: keep it out of search engines -->
    <meta name="robots" content="noindex, nofollow" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // A page cached from before an update may ask for scripts that are gone,
      // leaving its interactive parts empty. Reload once, fresh, in that case.
      (function () {
        function reloadOnce() {
          try {
            var last = +sessionStorage.getItem('auch.reloaded') || 0
            if (Date.now() - last < 30000) return
            sessionStorage.setItem('auch.reloaded', String(Date.now()))
          } catch (e) {}
          location.reload()
        }
        window.addEventListener('unhandledrejection', function (e) {
          var m = String((e.reason && e.reason.message) || e.reason || '')
          if (/dynamically imported module|Importing a module script failed|error loading dynamically imported/i.test(m)) reloadOnce()
        })
        window.addEventListener('error', function (e) {
          var t = e.target
          if (t && t.tagName === 'SCRIPT' && /\/_astro\//.test(t.src || '')) reloadOnce()
        }, true)
      })()
    </script>
  </head>
  <body style={`--accent:${accent}`}>
    <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
      <div class="absolute -top-40 left-1/2 h-[42rem] w-[70rem] -translate-x-1/2 rounded-full opacity-30 blur-[120px]" style="background: radial-gradient(closest-side, #6d5dfc, transparent)"></div>
      <div class="absolute -top-20 right-[-10rem] h-[30rem] w-[30rem] rounded-full opacity-20 blur-[120px]" style="background: radial-gradient(closest-side, #ff4f8b, transparent)"></div>
      <div class="absolute inset-0 opacity-[0.05]" style="background-image: radial-gradient(#fff 1px, transparent 1px); background-size: 26px 26px; mask-image: linear-gradient(to bottom, black, transparent 70%)"></div>
    </div>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />

    <!-- pictures big: anything with data-zoom (its value or the picture inside); a click next to it or Esc closes -->
    <div id="zoom" aria-hidden="true" class="pointer-events-none fixed inset-0 z-[100] grid cursor-zoom-out place-items-center bg-black/70 p-4 opacity-0 backdrop-blur-md transition-opacity duration-200 sm:p-10">
      <img id="zoom-img" alt="" class="max-h-full max-w-full scale95 cursor-default rounded-xl shadow-[0_40px_120px_-30px_rgba(0,0,0,0.9)] ring-1 ring-white/10 transition-transform duration-200" />
    </div>
    <script>
      const box = document.getElementById('zoom')!
      const img = document.getElementById('zoom-img') as HTMLImageElement
      const open = (src: string, alt: string) => {
        img.src = src
        img.alt = alt
        box.classList.remove('opacity-0', 'pointer-events-none')
        box.setAttribute('aria-hidden', 'false')
        requestAnimationFrame(() => img.classList.remove('scale95'))
        document.documentElement.style.overflow = 'hidden'
      }
      const close = () => {
        box.classList.add('opacity-0', 'pointer-events-none')
        box.setAttribute('aria-hidden', 'true')
        img.classList.add('scale95')
        document.documentElement.style.overflow = ''
      }
      document.addEventListener('click', e => {
        const t = (e.target as HTMLElement).closest?.('[data-zoom]') as HTMLElement | null
        if (t) {
          e.preventDefault()
          const inner = t.querySelector('img')
          open(t.dataset.zoom || inner?.src || '', inner?.alt || '')
          return
        }
        if (box.getAttribute('aria-hidden') === 'false' && e.target !== img) close()
      })
      document.addEventListener('keydown', e => { if (e.key === 'Escape') close() })
    </script>
  </body>
</html>
